{
  "manifest_version": 3,
  "name": "UET Downloader Pro - by HBM - Dawn",
  "version": "2.2",
  "author": "by HBM - Dawn",
  "description": "Tự động tải nhiều bài giảng (Google Drive), tài liệu và file trên portal UET. by HBM - Dawn.",
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://portal.uet.vnu.edu.vn/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://drive.usercontent.google.com/*",
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UET Downloader - by HBM - Dawn",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.uet.vnu.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "uet-downloader@example.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}